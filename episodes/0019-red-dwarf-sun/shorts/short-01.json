 "claims": [
  {
   "claim": "Roughly three-quarters of stars in our galaxy are red dwarfs",
   "source": 0
  },
  {
   "claim": "Red dwarfs are small, cool and dim; Proxima b in its star's habitable zone orbits closer than Mercury does to the Sun",
   "source": 1
  },
  {
   "claim": "Proxima b orbits in about 11 days",
   "source": 1
  },
  {
   "claim": "Planets in red-dwarf habitable zones are probably tidally locked, with one face always toward the star and the far side in frozen night",
   "source": 2
  },
  {
   "claim": "Red dwarfs flare; a study found an Earth-like atmosphere may not survive at Proxima b's orbit",
   "source": 3
  },
  {
   "claim": "Sun-like stars last about 10 billion years; red dwarfs take trillions of years to burn their fuel",
   "source": 4
  },
  {
   "claim": "The smallest red dwarfs will live for trillions of years",
   "source": 5
  },
  {
   "claim": "Left at 1 AU from a dim red dwarf, Earth would probably freeze (inference from habitable zone being inside Mercury's orbit, phrased as 'probably')",
   "source": 1
  },
  {
   "claim": "Proxima b receives extreme ultraviolet bursts hundreds of times stronger than Earth gets from the Sun",
   "source": 3
  }
