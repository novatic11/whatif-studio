 "claims": [
  {
   "claim": "Yellowstone's three large eruptions were about 2.08, 1.3 and 0.631 million years ago; Yellowstone is not overdue",
   "source": 0
  },
  {
   "claim": "The magma erupted 2.1 million years ago was nearly 6,000 times the volume of the 1980 Mount St. Helens eruption",
   "source": 1
  },
  {
   "claim": "USGS Ash3d modeling of a supereruption: umbrella cloud pushes ash more than 1,500 km; deposits decimeters to meters in the northern Rockies, centimeters in the northern Midwest, millimeters to centimeters on the coasts",
   "source": 2
  },
  {
   "claim": "Pinatubo (1991) dropped global temperatures by up to 0.7 C at the height of its impact; Pinatubo was about 1,000 times smaller than Yellowstone's largest eruption",
   "source": 3
  },
  {
   "claim": "A caldera-forming Yellowstone eruption would probably alter global weather patterns and affect agriculture for many years",
   "source": 3
  },
  {
   "claim": "The annual probability of another caldera-forming Yellowstone eruption is about 1 in 730,000",
   "source": 4
  }
 ],
