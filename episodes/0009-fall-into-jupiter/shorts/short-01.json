 "claims": [
  {
   "claim": "Jupiter has no solid surface",
   "source": 3
  },
  {
   "claim": "Galileo probe released 1995, entered atmosphere Dec 7 1995 at about 106,000 mph",
   "source": 1
  },
  {
   "claim": "Probe returned data for about an hour (58-61 min); failed ~180 km down at ~22-23 atmospheres",
   "source": 0
  },
  {
   "claim": "Jupiter's clouds are largely ammonia ice (with water and ammonium hydrosulfide deeper)",
   "source": 3
  },
  {
   "claim": "Hydrogen gradually becomes denser/liquid with no sharp surface",
   "source": 4
  },
  {
   "claim": "About a third of the way down, ~2 million bar and 8,000-10,000 °C, hydrogen becomes metallic",
   "source": 2
  },
  {
   "claim": "Jupiter's core composition is uncertain; Juno was meant to help resolve it",
   "source": 2
  }
 ],
