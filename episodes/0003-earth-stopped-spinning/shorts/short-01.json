 "claims": [
  {
   "claim": "The equator moves east at roughly 1,000 mph (about 1,036 mph x cos latitude)",
   "source": 0
  },
  {
   "claim": "In a sudden stop, the atmosphere and oceans would keep moving east at close to their original speed",
   "source": 1
  },
  {
   "claim": "With no rotation relative to the stars, one solar day would last a year, with about six months of day and six of night",
   "source": 0
  },
  {
   "claim": "Without rotation the oceans would migrate toward the poles",
   "source": 0
  },
  {
   "claim": "Esri's model shows a huge equatorial megacontinent and two large polar oceans",
   "source": 2
  },
  {
   "claim": "Rotation speed falls with latitude (speed = 1,036 mph x cos latitude), near zero at the poles",
   "source": 0
  },
  {
   "claim": "Earth's magnetic field could weaken because rotation helps drive the dynamo (speculative)",
   "source": 3
  },
  {
   "claim": "An abrupt stop of Earth's rotation is virtually impossible",
   "source": 1
  }
 ],
