 "claims": [
  {
   "claim": "In an airless tunnel, speed at the center is about 7.9 km/s, equal to low orbital speed",
   "source": 3
  },
  {
   "claim": "Fall through Earth's center takes about 38 minutes with realistic density",
   "source": 0
  },
  {
   "claim": "The classic 42-minute figure assumes uniform density",
   "source": 2
  },
  {
   "claim": "Without friction you would oscillate back and forth indefinitely",
   "source": 1
  },
  {
   "claim": "With air in the shaft, drag slows the fall dramatically; you'd come to rest at the centre",
   "source": 4
  }
 ],
